import phonenumbers
from phonenumbers import geocoder, carrier, timezone

# Indian Phone Number Information Tool

print("=" * 40)
print("   INDIAN PHONE NUMBER INFORMATION")
print("=" * 40)

# Phone number to check
number = "+919037152014"

try:
    phone = phonenumbers.parse(number, None)

    print("\n--- PHONE DETAILS ---")

    print("Phone Number:",
          phonenumbers.format_number(
              phone,
              phonenumbers.PhoneNumberFormat.INTERNATIONAL
          ))

    print("Country Code:", phone.country_code)

    print("Country: India")

    print("Region:",
          geocoder.description_for_number(phone, "en"))

    print("Possible Number:",
          phonenumbers.is_possible_number(phone))

    print("Valid Number:",
          phonenumbers.is_valid_number_for_region(phone, "IN"))

    print("Carrier:",
          carrier.name_for_number(phone, "en") or "Not available")

    print("Time Zone:",
          timezone.time_zones_for_number(phone))

    print("\n--- CHECK COMPLETE ---")

except phonenumbers.NumberParseException as error:
    print("Error:", error)

print("\nNote: This tool cannot identify the owner's")
print("name, private address or live location.")
